{
  "name": "wagering-processor",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test scripts",
    "test": "bun test",
    "start": "bun src/main.ts",
    "worker": "bun src/worker-main.ts",
    "migration:up": "bun ./node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "bun ./node_modules/@mikro-orm/cli/cli.js migration:down",
    "queues:up": "bun scripts/create-queues.ts",
    "infra:up": "docker compose up -d --wait"
  },
  "mikro-orm": {
    "alwaysAllowTs": true,
    "configPaths": [
      "./src/persistence/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/nestjs": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "ajv": "8",
    "decimal.js": "10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mikro-orm/cli": "6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.15.6",
    "bun-types": "^1.4.4",
    "eslint": "9",
    "typescript": "5",
    "typescript-eslint": "^8.72.1"
  }
}
